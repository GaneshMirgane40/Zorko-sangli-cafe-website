# Copy to .env.local (git-ignored) and fill in real values. Never commit real values.
# See docs/DEPLOYMENT.md §3 for where each value comes from.

# ── Phase 2 ─────────────────────────────────────────────
# Public base URL of the site: canonical links, QR code target, Origin allowlist.
# Local: http://localhost:3000 · Production: your https domain (http/localhost is rejected on Vercel production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only to expose /dev/styleguide in a production build (used by the E2E tests).
# ENABLE_STYLEGUIDE=true

# ── Phase 3+ (not used yet) ─────────────────────────────
# DATABASE_URL=postgresql://<pooled transaction-mode connection string>
# DIRECT_URL=postgresql://<direct or session connection string>
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>
# SUPABASE_SECRET_KEY=<secret or service_role key — server only>
# RATE_LIMIT_SALT=<openssl rand -hex 32>
# SUPABASE_STORAGE_BUCKET=public-media
# ALLOW_DEMO_SEED=true
